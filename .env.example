# Local development only. Replace placeholders; do not commit .env.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://enterpriseiq:replace-with-local-password@127.0.0.1:55432/enterpriseiq
# Optional separate database for PostgreSQL integration tests:
# TEST_DATABASE_URL=postgresql://enterpriseiq:replace-with-local-password@127.0.0.1:55432/enterpriseiq_test

# DeepSeek model calls (configure locally; never paste a key into chat)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Required for all paid entrypoints. Point every CLI/worker/evaluator at the SAME
# authority even when DATABASE_URL changes for an isolated evaluation dataset.
BUDGET_DATABASE_URL=postgresql://enterpriseiq:replace-with-local-password@127.0.0.1:55432/enterpriseiq

# Local workbench (provision identities with enterpriseiq-web-user)
ENTERPRISEIQ_USERS_FILE=.secrets/web-users.json
ENTERPRISEIQ_WEB_DIST=web/dist
ENTERPRISEIQ_ORIGIN=http://127.0.0.1:8000
# Use 1 with HTTPS; 0 is only for loopback HTTP development.
ENTERPRISEIQ_COOKIE_SECURE=0
